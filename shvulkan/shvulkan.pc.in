prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix} # Legacy option for multi-arch builds
libdir=${prefix}/lib
includedir=${prefix}/include

Name: shvulkan
Description: A C wrapper around the Vulkan API
Version: @SH_VULKAN_VERSION@
URL: @SH_VULKAN_DOCS_URL@
Libs: -L${libdir} -l@SH_VULKAN_LIBRARY@
# Libs.private: -l@Vulkan_LIBRARY@ # prefer Requires.private if Vulkan has a pkgconfig file
Requires.private: vulkan # cleaner option
Cflags: -I${includedir}